{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-gb",
      "type": "shell",
      "command": "make -j8",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "build-gb-fake",
      "type": "shell",
      "command": "make -j8 FAKE=1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "clean-gb",
      "type": "shell",
      "command": "make clean",
      "group": "build",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
